# ChromaDB Cloud Configuration
# Copy this to .env and fill in your credentials from https://www.trychroma.com/

# Client Type: "local" (default) or "cloud"
CHROMA_CLIENT_TYPE=cloud

# ChromaDB Cloud Credentials (get from https://www.trychroma.com/)
CHROMA_HOST=api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=your_api_key_here

# Optional: Tenant and Database (use defaults if unsure)
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Note: When CHROMA_CLIENT_TYPE=local, these cloud settings are ignored
# and CHROMA_DB_PATH is used instead (defaults to voice/rag/chroma_db)
