# Voice Ledger Environment Variables

# =============================================================================
# OpenAI API (Required for Phase 1+2, v2.0 uses GPT-4)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_openai_org_id_here  # Optional

# =============================================================================
# Gemini Fallback (Optional - used when OpenAI is unavailable/quota-limited)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI-compatible Gemini endpoint (leave as default unless instructed)
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model mapping for fallback
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
# Fallback controls
LLM_FALLBACK_ENABLED=true

# =============================================================================
# LiveKit Voice Worker - Provider Selection
# =============================================================================
# Select LLM provider strategy: auto | openai | gemini
# - auto: OpenAI primary, Gemini fallback on health-check/circuit failure
# - openai: force OpenAI only
# - gemini: force Gemini only
LIVEKIT_LLM_PROVIDER=auto
# If OpenAI fails at runtime (e.g. quota/rate/billing), circuit opens and
# new sessions use Gemini for this many seconds.
LIVEKIT_OPENAI_CIRCUIT_TTL_SEC=900
LIVEKIT_OPENAI_HEALTHCHECK=true
LIVEKIT_OPENAI_HEALTHCHECK_MODEL=gpt-4o-mini
LIVEKIT_OPENAI_MODEL=gpt-4o-mini
LIVEKIT_GEMINI_MODEL=gemini-2.5-flash
LIVEKIT_LLM_TEMPERATURE=0.2

# TTS configuration
# Select TTS provider strategy: auto | openai | deepgram
# - auto: prefer Deepgram when fallback mode is enabled and key exists
LIVEKIT_OPENAI_TTS_MODEL=tts-1
LIVEKIT_OPENAI_TTS_VOICE=nova
LIVEKIT_TTS_PROVIDER=auto
# Used when Gemini LLM fallback is active (requires DEEPGRAM_API_KEY)
LIVEKIT_DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# =============================================================================
# ChromaDB Cloud (v2.0 - RAG Vector Database)
# =============================================================================
# Sign up at: https://trychroma.com
CHROMA_API_KEY=your_chromadb_api_key_here
CHROMA_COLLECTION=voice_ledger_docs

# =============================================================================
# AddisAI (v2.0 - Amharic Conversational AI - Optional)
# =============================================================================
# Contact AddisAI for API access
ADDIS_AI_API_KEY=your_addisai_api_key_here  # Optional

# =============================================================================
# Telegram Bot (Required for Telegram integration & Mini Apps)
# =============================================================================
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username  # e.g., voice_ledger_bot

# =============================================================================
# Voice Ledger API Authentication
# =============================================================================
VOICE_LEDGER_API_KEY=your_secure_api_key_here

# =============================================================================
# Database (Neon PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@hostname/database

# =============================================================================
# Celery & Redis (Phase 2)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# AI Agent (v3.0 — tool-calling agent that replaces NLU pipeline)
# =============================================================================
# Set to "true" to enable the GPT-4o agent path (recommended for production)
AGENT_ENABLED=true
AGENT_MODEL=gpt-4o           # Model for tool-calling (default: gpt-4o)
AGENT_MAX_TURNS=6             # Max tool-calling rounds per request (default: 6)
AGENT_TEMPERATURE=0.2         # Lower = more deterministic (default: 0.2)

# =============================================================================
# App Configuration
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=your_secret_key_here

# Base URL for webhooks and Mini Apps (local or production)
BASE_URL=http://localhost:8000  # For local development
# BASE_URL=https://voice-ledger-api.up.railway.app  # For production

# =============================================================================
# Twilio (Phase 3 - IVR/Phone System)
# =============================================================================
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional: For sending SMS from different number
TWILIO_SMS_FROM=+1234567890

# Webhook base URL (use ngrok for local testing, or your production domain)
# For local: start ngrok with "ngrok http 8000" and paste URL here
NGROK_URL=https://your-ngrok-subdomain.ngrok.io

# Optional: For SMS notifications
TWILIO_SMS_FROM=+1234567890  # Same as TWILIO_PHONE_NUMBER or different

# =============================================================================
# Global Forest Watch API (EUDR Deforestation Checking)
# =============================================================================
# Free API - Register at: https://data-api.globalforestwatch.org
# Run: python scripts/register_gfw_api.py
GFW_API_KEY=your_gfw_api_key_uuid_here

# =============================================================================
# Development Settings
# =============================================================================
# Set to 'development' for local testing, 'production' for deployment
ENVIRONMENT=development

# Python version (for Railway deployment)
PYTHON_VERSION=3.9

# =============================================================================
# Blockchain — Base Sepolia Deployment
# ============================================================================
# RPC endpoint (Alchemy, Infura, or public)
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# Deployer wallet private key (with 0x prefix)
PRIVATE_KEY_SEP=0xYOUR_PRIVATE_KEY
# Block explorer verification
ETHERSCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Deployed contract addresses (set after running deploy scripts)
EPCIS_EVENT_ANCHOR_ADDRESS=0x0000000000000000000000000000000000000000
COFFEE_BATCH_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================================================
# Chainlink CRE Integration
# ============================================================================
# ProvenanceDataReceiver contract (deploy with DeployProvenanceReceiver.s.sol)
PROVENANCE_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
# CRE CLI requires the private key WITHOUT the 0x prefix (same wallet as PRIVATE_KEY_SEP)
CRE_ETH_PRIVATE_KEY=your_private_key_without_0x_prefix
# DON gateway URL (leave blank for simulation mode)
# CRE_DON_GATEWAY_URL=
# Local provenance API base URL (for CRE workflow HTTP triggers)
CRE_API_BASE_URL=http://localhost:8100

# Legacy Chainlink Functions (if used)
# CHAINLINK_SUBSCRIPTION_ID=
# CHAINLINK_ROUTER_ADDRESS=
# CHAINLINK_DON_ID=
# CHAINLINK_GAS_LIMIT=300000

# ============================================================================
# IPFS (Optional)
# ============================================================================
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_KEY=your_pinata_secret_key
